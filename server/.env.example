TEMPORAL_ACTIVITY_RETRY_MAX_ATTEMPT=3


REMOTE_CODE_EXECUTION_PROVIDER="aws_lambda"
CODE_EXEC_SIGNING_SECRET="devsecret"

# =============================================================================
# Agentic Coding
# =============================================================================

# Modal Credentials (required)
# ----------------------------
# API token for Modal (https://modal.com). Required to provision sandboxes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal Server
# ----------------------------
# gRPC endpoint for the Modal API.
# MODAL_SERVER_URL=api.modal.com:443
# Modal environment to use (e.g., "main").
# MODAL_ENVIRONMENT=main

# Docker Hub Credentials (optional)
# ----------------------------
# Used by Modal to pull private base images from Docker Hub.
# DOCKER_HUB_REGISTRY_USERNAME=
# DOCKER_HUB_REGISTRY_PASSWORD=

# Sandbox Provider & Resources
# ----------------------------
# Provider for sandbox execution. Options: modal, local (default: modal).
# AGENTIC_CODING_SANDBOX_PROVIDER=modal
# Pre-built Modal image ID for sandboxes (set after first image build).
# AGENTIC_CODING_IMAGE_ID=
# Modal secret ID containing LLM API keys injected into the sandbox.
# AGENTIC_CODING_LLM_SECRET_ID=
# Maximum sandbox lifetime in seconds (default: 3600 = 1 hour).
# AGENTIC_CODING_SANDBOX_TIMEOUT=3600
# Sandbox idle timeout in seconds before auto-shutdown (default: 1200 = 20 min).
# AGENTIC_CODING_SANDBOX_IDLE_TIMEOUT=1200
# CPU in millicores allocated to each sandbox (default: 2000 = 2 vCPU).
# AGENTIC_CODING_SANDBOX_CPU=2000
# Memory in MB allocated to each sandbox (default: 4096 = 4 GB).
# AGENTIC_CODING_SANDBOX_MEMORY=4096
# Max parallel target workspaces when cloning one app to many (default: 5).
# AGENTIC_CODING_CLONE_THREAD_POOL_SIZE=5
# Modal secret (deployment name) holding the Docker registry creds used when importing
# template images during sync (default: aisquared-docker-creds).
# MODAL_DOCKER_SECRET=aisquared-docker-creds
# Bearer token for the internal /templates/sync endpoint. appgen-templates CI sends this in
# the Authorization header. Generate with: openssl rand -hex 32
# AGENTIC_CODING_SYNC_TOKEN=

# Deployment Resources
# ----------------------------
# CPU/memory for deployed apps (smaller than sandboxes).
# AGENTIC_CODING_DEPLOY_CPU=1000
# AGENTIC_CODING_DEPLOY_MEMORY=2048

# Coding Agent
# ----------------------------
# Agent framework. Options: opencode (default: opencode).
# CODING_AGENT_PROVIDER=opencode
# Default LLM model identifier used by the coding agent when no tier is selected.
# CODING_AGENT_MODEL=anthropic/claude-sonnet-5-5
# Per-tier model overrides for the AppBuilder model dropdown (Fast/Balanced/Advanced).
# CODING_AGENT_MODEL_FAST=anthropic/claude-haiku-5-5
# CODING_AGENT_MODEL_BALANCED=anthropic/claude-sonnet-5-5
# CODING_AGENT_MODEL_ADVANCED=anthropic/claude-opus-5-5
# API key for the coding agent's LLM provider (injected into sandbox via Modal secret).
# CODING_AGENT_MODEL_API_KEY=
# Extra "More models" providers; each is enabled only when its key is set. P2W model selection uses the same keys.
# CODING_AGENT_OPENAI_API_KEY=
# CODING_AGENT_XAI_API_KEY=
# CODING_AGENT_GOOGLE_API_KEY=
# CODING_AGENT_ANTHROPIC_API_KEY=
# Kill switch for the "More models" submenu. Default: true; set to false to show tiers only.
# AGENTIC_CODING_MORE_MODELS_ENABLED=false
# Path to the model catalog YAML (default: enterprise/config/agentic_coding/model_catalog.yml).
# AGENTIC_CODING_MODEL_CATALOG_PATH=

# ----------------------------
# Prompt to Workflow (AI Workflow Builder)
# ----------------------------
# Fallback LLM when model selection is off or no catalog model is available.
# Providers: openai (default), anthropic, bedrock, sagemaker.
# P2W_LLM_PROVIDER=openai
# P2W_LLM_MODEL=gpt-4o
# P2W_LLM_API_KEY=
# P2W_LLM_TEMPERATURE=0
# Model picker in the AI Workflow Builder: the tiers plus p2w.include models whose provider key is set.
# Default: true. Workflows with no saved model then run on p2w.default (Balanced) instead of the env
# model above, billed to CODING_AGENT_MODEL_API_KEY. Set to false to hide the picker and use the env model.
# P2W_MODEL_SELECTION_ENABLED=true
# Kill switch for the clarify-and-plan behavior (agent asks clarifying questions and
# requests plan approval via the question tool before non-trivial builds). Default: true.
# AGENTIC_CODING_ASK_QUESTIONS_ENABLED=true
# Kill switch for updating/deleting existing source connectors from the App Builder chat:
# removes the MANAGING DATA SOURCES prompt block and makes the connectors_update and
# connectors_delete MCP tools refuse every call. Default: true.
# AGENTIC_CODING_CONNECTOR_MANAGE_ENABLED=true
# Kill switch for custom MCP tool support in coding sessions. When false, the
# custom-tools MCP endpoint refuses all calls. Default: false.
# AGENTIC_CODING_CUSTOM_TOOLS_ENABLED=true
# Max minutes a prompt may stay blocked on an unanswered question before the status
# poller times it out (default: 120).
# AGENTIC_CODING_QUESTION_WAIT_TIMEOUT_MINUTES=120

# Idle Session Suspension (Temporal Workflow)
# ----------------------------
# Cron interval for the snapshot-and-suspend workflow (default: every 10 min).
# AGENTIC_CODING_SNAPSHOT_INTERVAL=*/10 * * * *
# Minutes of inactivity before a session is considered idle (default: 10).
# AGENTIC_CODING_IDLE_THRESHOLD=10

# Security Scanning (App Builder)
# ----------------------------
# Kill switch for app security scans (default: true).
# AGENTIC_CODING_SECURITY_SCAN_ENABLED=true
# Detection engine (default: static).
# AGENTIC_CODING_SECURITY_SCAN_ENGINE=static
# Engine budget per scan in seconds (default: 180).
# AGENTIC_CODING_SECURITY_SCAN_TIMEOUT=180
# Comma-separated scanner ids to disable (osv, gitleaks).
# AGENTIC_CODING_SECURITY_SCAN_DISABLED_SCANNERS=

# Database Provider (Neon)
# ----------------------------
# Database provider for agentic coding apps. Options: neon (default: neon).
# AGENTIC_CODING_DB_PROVIDER=neon
# Neon API key (required for database provisioning).
# NEON_API_KEY=
# Neon API base URL.
# NEON_API_BASE_URL=https://console.neon.tech/api/v2
# Default region for Neon projects.
# NEON_DEFAULT_REGION=aws-us-east-1

# Secrets (required)
# ----------------------------
# Primary key for Active Record encryption (connector configuration, app resource credentials).
# Required. Every Rails process (server, Temporal worker, Solid Queue worker) must use the same value.
# Set before first deploy. Do NOT change after data is encrypted. Generate with: openssl rand -hex 32
# Upgrading an install where this was unset or blank: it fell back to SECRET_KEY_BASE, so set it to that same value
# (or re-encrypt existing data first), else old encrypted credentials can't be decrypted.
AR_ENCRYPTION_PRIMARY_KEY=
# Secret used to sign and verify user JWTs. Required in production, boot fails without it.
# Generate with: openssl rand -hex 64
JWT_SECRET=

# Local Development (sandbox_provider=local only)
# ----------------------------
# AGENTIC_CODING_LOCAL_SANDBOX_URL=http://localhost:4096
# AGENTIC_CODING_LOCAL_PREVIEW_URL=http://localhost:5173
# Path to the local app directory (required for local provider DB injection).
# AGENTIC_CODING_LOCAL_APP_DIR=

# Agentic Coding — GitHub App integration
# ----------------------------
# The GitHub App the sandbox uses for repo/branch/target operations and OAuth
# roundtrips (Connect flow, install/setup callback, webhook receiver). All of
# AGENTIC_CODING_GITHUB_APP_ID / AGENTIC_CODING_GITHUB_APP_SLUG / AGENTIC_CODING_GITHUB_APP_CLIENT_ID / AGENTIC_CODING_GITHUB_APP_CLIENT_SECRET
# / AGENTIC_CODING_GITHUB_WEBHOOK_SECRET / (AGENTIC_CODING_GITHUB_APP_PRIVATE_KEY or AGENTIC_CODING_GITHUB_APP_PRIVATE_KEY_PATH)
# must be set together for the provider to report enabled; otherwise the git
# feature is silently disabled in ListProviders.

# Numeric App ID from the GitHub App's General settings page.
# AGENTIC_CODING_GITHUB_APP_ID=
# URL slug of the GitHub App (the segment after /apps/ in the marketplace URL).
# Used to build the install URL (github.com/apps/<slug>/installations/new).
# AGENTIC_CODING_GITHUB_APP_SLUG=
# Client ID from the GitHub App's General settings. Doubles as the OAuth
# authorize URL's client_id parameter (github.com/login/oauth/authorize).
# AGENTIC_CODING_GITHUB_APP_CLIENT_ID=
# Client secret paired with AGENTIC_CODING_GITHUB_APP_CLIENT_ID for the OAuth token exchange.
# AGENTIC_CODING_GITHUB_APP_CLIENT_SECRET=
# Shared secret configured on the GitHub App's Webhook settings; used to
# verify X-Hub-Signature-256 on incoming webhook deliveries.
# AGENTIC_CODING_GITHUB_WEBHOOK_SECRET=
# GitHub App private key — provide EITHER the PEM contents directly (newlines
# encoded as literal \n; the loader unescapes them) OR a filesystem path to
# a PEM file. Used to sign installation-token JWTs.
# AGENTIC_CODING_GITHUB_APP_PRIVATE_KEY=
# AGENTIC_CODING_GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app.pem
# Identity used for sandbox-side git commits (seed commit, autopushes).
# Both default to the AppBuilder placeholder if unset.
# AGENTIC_CODING_GITHUB_BOT_EMAIL=appbuilder-bot@example.com
# AGENTIC_CODING_GITHUB_BOT_NAME=AppBuilder Bot

# Agentic Coding: Custom domains
# ----------------------------
# Base URL and API key of the custom-domains service (Caddy) that registers
# customer domains and issues their certificates. Both must be set for Verify
# and delete to reach the service.
# CUSTOM_DOMAINS_BASE_URL=
# CUSTOM_DOMAINS_API_KEY=
# Shared secret used to verify X-Custom-Domains-Signature on webhook deliveries
# from the service. Must match the service's CUSTOM_DOMAINS_RAILS_WEBHOOK_SECRET.
# CUSTOM_DOMAINS_WEBHOOK_SECRET=
# Hostname customers point their CNAME at. Shown in the custom-domain setup
# instructions; left blank, no CNAME target is shown.
# APPGEN_CUSTOM_DOMAIN_CNAME_TARGET=

# Model Hub Spending Limits
# ----------------------------
# Whether an exhausted limit actually refuses the call. Metering and alerts run either way,
# so set this to false to keep counting without blocking anyone (default: true).
# SPENDING_LIMIT_ENFORCEMENT_ENABLED=true
# Kill switch for writing usage events and moving counters (default: true).
# SPENDING_LIMIT_METERING_ENABLED=true
# Cost difference below which the nightly reconciler leaves a counter alone (default: 0.01).
# COUNTER_DRIFT_EPSILON=0.01
# Source for the nightly model price sync.
# PRICING_SYNC_URL=
